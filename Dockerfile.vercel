FROM dunglas/frankenphp:1-php8.4-alpine AS php-base
WORKDIR /app
RUN install-php-extensions pdo_mysql pdo_pgsql mbstring intl zip gd bcmath \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

FROM php-base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . .
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader --no-scripts \
    && php artisan package:discover --ansi

FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY scripts/copy-assets.mjs ./scripts/copy-assets.mjs
COPY images ./images
COPY resources ./resources
COPY vite.config.js ./
RUN npm run build

FROM php-base AS runtime
ENV APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr \
    SESSION_DRIVER=database SESSION_SECURE_COOKIE=true CACHE_STORE=database \
    QUEUE_CONNECTION=sync PROJECT_UPLOAD_DISK=s3 VERCEL=1 PORT=80
COPY --from=dependencies /app /app
COPY --from=frontend /app/public/build /app/public/build
COPY --from=frontend /app/public/images /app/public/images
COPY Caddyfile /etc/caddy/Caddyfile
RUN printf 'upload_max_filesize=8M\npost_max_size=12M\n' > "$PHP_INI_DIR/conf.d/uploads.ini" \
    && chmod +x /app/scripts/container-entrypoint.sh
ENTRYPOINT ["/app/scripts/container-entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
